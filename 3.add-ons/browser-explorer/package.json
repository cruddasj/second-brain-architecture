{
  "name": "second-brain-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/build-brain-data.mjs",
    "dev": "next dev",
    "demo": "node scripts/demo.mjs",
    "demo:build": "node scripts/build-demo-data.mjs",
    "prebuild": "node scripts/prepare-shell.mjs",
    "build": "next build",
    "postbuild": "node scripts/offline-shell.mjs",
    "brain:build": "node scripts/build-brain-data.mjs",
    "brain:check": "node scripts/build-brain-data.mjs && python ../../2.core/scripts/check_second_brain.py",
    "start": "node scripts/demo.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "npm run build && npm run brain:build && node --import tsx --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "cytoscape": "^3.34.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  },
  "type": "module",
  "displayName": "Second Brain Explorer"
}
