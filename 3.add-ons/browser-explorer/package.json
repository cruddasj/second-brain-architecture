{
  "name": "second-brain-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/build-brain-data.mjs",
    "dev": "next dev",
